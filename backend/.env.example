# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chroma runs as a separate local server.
# Start it with: chroma run --path ./chroma_data
CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=ask_my_pdf_gemini_chunks

PORT=4000
