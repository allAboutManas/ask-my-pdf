# Copy this file to .env and fill in your real key.
# NEVER commit the real .env file to git.

# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Model configuration (recommended defaults for current Google AI Studio access)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Cloud / hosted cluster configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chunk1
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine

# Optional debug logging
LOG_LEVEL=debug

PORT=4000
